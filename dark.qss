/* ============================================================
   爱宠 DICOM 阅读器 —— 温暖橙主题 (warm orange)
   基调：暖棕深色底 + 琥珀橙强调色，低对比、轻松不刺眼。
   配色：
     背景 #1f1812 / 面板 #271f17 / 输入 #2e2419
     描边 #4a3a2c / 正文 #f0e6da / 次要 #c3ae97
     强调 #e8842a / 悬停 #f59a3f / 按下 #c46a18
   ============================================================ */

QMainWindow, QWidget {
    background-color: #1f1812;
    color: #f0e6da;
    font-family: "Segoe UI", "Verdana", sans-serif;
    font-size: 9pt;
    font-weight: 500;
}

QTabWidget::pane {
    background: #271f17;
    border: 1px solid #4a3a2c;
    border-radius: 5px;
    padding: 1px;
}
QTabBar::tab {
    background: #271f17;
    color: #c3ae97;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    padding: 4px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 600;
    font-size: 9pt;
}
QTabBar::tab:selected {
    background: #33271c;
    color: #ffe6c6;
    border-bottom: 2px solid #e8842a;
}
QTabBar::tab:hover:!selected {
    background: #2c2118;
    color: #e6cfae;
}

QGroupBox {
    background: #261d15;
    border: 1px solid #3d2f22;
    border-radius: 4px;
    margin-top: 8px;
    padding: 10px 6px 4px 6px;
    font-weight: 600;
    color: #e2cfb6;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #f2dcc0;
}

QCheckBox {
    color: #ecdfcd;
    spacing: 6px;
    font-weight: 500;
    font-size: 10pt;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #6a5238;
    border-radius: 3px;
    background: #2a2018;
}
QCheckBox::indicator:checked {
    background: #e8842a;
    border-color: #f59a3f;
}
QCheckBox::indicator:hover {
    border-color: #a07a48;
}
QCheckBox::indicator:disabled {
    background: #221a12;
    border-color: #3a2c20;
}

QSpinBox, QDoubleSpinBox {
    background: #2e2419;
    color: #f0e2cc;
    border: 1px solid #4a3a2c;
    border-radius: 4px;
    padding: 2px 5px;
    min-height: 20px;
    font-weight: 500;
    font-size: 9pt;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #6a5238;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #e8842a;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #35281c;
    border-left: 1px solid #4a3a2c;
    width: 14px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #4a3a2c;
}

QProgressBar {
    background: #2e2419;
    border: 1px solid #3d2f22;
    border-radius: 4px;
    text-align: center;
    color: #f2e2cc;
    min-height: 16px;
    font-weight: 600;
    font-size: 9pt;
}
QProgressBar::chunk {
    background: #e8842a;
    border-radius: 3px;
}

QLabel {
    color: #ecdfcd;
    background: transparent;
    font-weight: 500;
    font-size: 9pt;
}

QComboBox {
    background: #2e2419;
    color: #f0e2cc;
    border: 1px solid #4a3a2c;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 22px;
    font-weight: 500;
}
QComboBox:hover {
    border-color: #6a5238;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #2e2419;
    color: #f0e2cc;
    border: 1px solid #4a3a2c;
    selection-background-color: #b8621a;
}

QScrollBar:horizontal {
    background: #241b14;
    height: 9px;
    border-radius: 4px;
}
QScrollBar:vertical {
    background: #241b14;
    width: 9px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #5a4432;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #5a4432;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background: #7a5c40;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}

/* ============================================================
   分隔条 (QSplitter): 左侧参数栏 ↔ 右侧渲染视图
   ============================================================ */
QSplitter::handle {
    background: #241b14;
}
QSplitter::handle:horizontal {
    width: 8px;
    background: #5a4432;
}
QSplitter::handle:vertical {
    height: 8px;
    background: #5a4432;
}
QSplitter::handle:horizontal:hover, QSplitter::handle:vertical:hover {
    background: #e8842a;
}
QSplitter::handle:horizontal:pressed, QSplitter::handle:vertical:pressed {
    background: #f59a3f;
}

/* 署名徽章（状态栏右侧）—— 单独提权放大加粗。
   CLabel._change_theme() 会重写其自身样式表，故字体规则只能写在这里。 */
QLabel#creditLabel {
    font-weight: bold;
    font-size: 11pt;
}

QToolTip {
    background: #33271c;
    color: #f2e2cc;
    border: 1px solid #4a3a2c;
    padding: 4px;
    border-radius: 4px;
    font-weight: 500;
}

QMessageBox {
    background-color: #261d15;
}
QMessageBox QLabel {
    color: #f2e2cc;
}

QMenu {
    background: #2e2419;
    color: #f0e2cc;
    border: 1px solid #4a3a2c;
    padding: 4px;
}
QMenu::item {
    padding: 4px 20px;
    border-radius: 3px;
}
QMenu::item:selected {
    background: #b8621a;
}

QScrollArea {
    border: none;
    background: transparent;
}

QTreeWidget, QTableWidget, QListWidget {
    background: #271f17;
    alternate-background-color: #2c2118;
    color: #ecdfcd;
    border: 1px solid #3d2f22;
    border-radius: 4px;
    gridline-color: #3d2f22;
}
QHeaderView::section {
    background: #33271c;
    color: #f2dcc0;
    border: none;
    border-right: 1px solid #3d2f22;
    border-bottom: 1px solid #3d2f22;
    padding: 3px 6px;
    font-weight: 600;
}
