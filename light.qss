/* ============================================================
   爱宠 DICOM 阅读器 —— 浅色明快暖橙主题 (light orange)
   基调：暖白底 + 明亮橙强调，轻松、通透、明快。
   配色：
     背景 #fdf8f2 / 面板 #fffdf9 / 输入 #ffffff
     描边 #e9dac2 / 正文 #3a2e22 / 次要 #8a7862
     强调 #f08c1e / 悬停 #ff9f3a / 按下 #d4761a
   ============================================================ */

QMainWindow, QWidget {
    background-color: #fdf8f2;
    color: #3a2e22;
    font-family: "Segoe UI", "Verdana", sans-serif;
    font-size: 9pt;
    font-weight: 500;
}

QTabWidget::pane {
    background: #fffdf9;
    border: 1px solid #ecdcc6;
    border-radius: 6px;
    padding: 2px;
}
QTabBar::tab {
    background: #f7ede0;
    color: #8a7862;
    border: 1px solid transparent;
    border-bottom: 3px solid transparent;
    padding: 5px 16px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: 600;
    font-size: 9pt;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #c46a18;
    border-bottom: 3px solid #f08c1e;
}
QTabBar::tab:hover:!selected {
    background: #fbf3e8;
    color: #a8641a;
}

QGroupBox {
    background: #fffdf9;
    border: 1px solid #ecdcc6;
    border-radius: 6px;
    margin-top: 9px;
    padding: 11px 7px 5px 7px;
    font-weight: 600;
    color: #a8641a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #c46a18;
    background: #fdf8f2;
}

QCheckBox {
    color: #3a2e22;
    spacing: 6px;
    font-weight: 500;
    font-size: 10pt;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #d8c4a8;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #f08c1e;
    border-color: #d4761a;
}
QCheckBox::indicator:hover {
    border-color: #f0a95a;
}
QCheckBox::indicator:disabled {
    background: #f2ece2;
    border-color: #e2d3bf;
}

QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    color: #3a2e22;
    border: 1px solid #e2d3bf;
    border-radius: 5px;
    padding: 2px 5px;
    min-height: 20px;
    font-weight: 500;
    font-size: 9pt;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #f0a95a;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #f08c1e;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #f7ede0;
    border-left: 1px solid #e2d3bf;
    width: 14px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #ffe6c6;
}

QProgressBar {
    background: #f4e8d8;
    border: 1px solid #ecdcc6;
    border-radius: 5px;
    text-align: center;
    color: #6a5238;
    min-height: 16px;
    font-weight: 600;
    font-size: 9pt;
}
QProgressBar::chunk {
    background: #f08c1e;
    border-radius: 4px;
}

QLabel {
    color: #3a2e22;
    background: transparent;
    font-weight: 500;
    font-size: 9pt;
}

QComboBox {
    background: #ffffff;
    color: #3a2e22;
    border: 1px solid #e2d3bf;
    border-radius: 5px;
    padding: 3px 8px;
    min-height: 22px;
    font-weight: 500;
}
QComboBox:hover {
    border-color: #f0a95a;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #3a2e22;
    border: 1px solid #e2d3bf;
    selection-background-color: #ffe0b8;
    selection-color: #5a3a10;
}

QScrollBar:horizontal {
    background: #f2e8da;
    height: 9px;
    border-radius: 4px;
}
QScrollBar:vertical {
    background: #f2e8da;
    width: 9px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #dcc6a6;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #dcc6a6;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background: #c9ac84;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}

/* ============================================================
   分隔条 (QSplitter): 左侧参数栏 ↔ 右侧渲染视图
   ============================================================ */
QSplitter::handle {
    background: #f2e8da;
}
QSplitter::handle:horizontal {
    width: 8px;
    background: #e6d6c0;
}
QSplitter::handle:vertical {
    height: 8px;
    background: #e6d6c0;
}
QSplitter::handle:horizontal:hover, QSplitter::handle:vertical:hover {
    background: #f0a95a;
}
QSplitter::handle:horizontal:pressed, QSplitter::handle:vertical:pressed {
    background: #f08c1e;
}

/* 署名徽章（状态栏右侧）—— 单独提权放大加粗。
   CLabel._change_theme() 会重写其自身样式表，故字体规则只能写在这里。 */
QLabel#creditLabel {
    font-weight: bold;
    font-size: 11pt;
}

QToolTip {
    background: #fff8ee;
    color: #3a2e22;
    border: 1px solid #e2d3bf;
    padding: 4px;
    border-radius: 4px;
    font-weight: 500;
}

QMessageBox {
    background-color: #fffdf9;
}
QMessageBox QLabel {
    color: #3a2e22;
}

QMenu {
    background: #ffffff;
    color: #3a2e22;
    border: 1px solid #e2d3bf;
    padding: 4px;
}
QMenu::item {
    padding: 4px 20px;
    border-radius: 3px;
}
QMenu::item:selected {
    background: #ffe0b8;
    color: #5a3a10;
}

QScrollArea {
    border: none;
    background: transparent;
}

QTreeWidget, QTableWidget, QListWidget {
    background: #ffffff;
    alternate-background-color: #fdf6ec;
    color: #3a2e22;
    border: 1px solid #ecdcc6;
    border-radius: 5px;
    gridline-color: #efe2d0;
}
QHeaderView::section {
    background: #f7ede0;
    color: #8a5a12;
    border: none;
    border-right: 1px solid #ecdcc6;
    border-bottom: 1px solid #ecdcc6;
    padding: 3px 6px;
    font-weight: 600;
}
